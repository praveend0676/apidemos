# Copy this file to .env and fill in your own credentials.
# .env is git-ignored and must never be committed.

# PostgreSQL (Neon, Supabase, local Postgres, ...)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# SQLite alternative (no extra setup, good for local dev)
# DATABASE_URL=sqlite:///enrollment.db

# Optional connection tuning (defaults shown).
# Ignored when DATABASE_URL is SQLite.
# DB_CONNECT_TIMEOUT=10
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
